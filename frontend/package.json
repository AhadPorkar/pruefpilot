{
  "name": "pruefpilot-web", "version": "1.0.0-rc.1", "private": true, "type": "module",
  "description": "PruefPilot - dependency-free browser runtime, strict TypeScript authoring",
  "engines": { "node": ">=26.12.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "typescript": "7.0.2", "@playwright/test": "1.64.1" }
}
